# Copy this file to .env and replace the values with your local configuration.
# NEVER commit .env to Git.

# MySQL
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hr_management

# Flask session signing key (use a long random value)
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# Optional application settings
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30
MAX_UPLOAD_MB=5

# JWT browser-cookie security
# Keep false for local HTTP development. Set true in HTTPS production.
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax
